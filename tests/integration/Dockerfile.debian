# A host with a real PID 1 systemd, which is the only way to test the ca_server
# role honestly: the whole design turns on what systemd does with a unit whose
# ConditionFileNotEmpty is unmet, and on systemctl's exit code when it skips
# one. Neither can be observed without systemd actually running.
#
# python3, python3-apt and sudo are Ansible's requirements, not the roles'.
#
# Everything the roles themselves need is deliberately absent - libcap2-bin,
# procps, and ca-certificates, without which the very first thing step_cli does
# over the network fails with a TLS error. If one of them is dropped from the
# role, the suite says so rather than the image quietly covering for it.
FROM debian:bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        dbus \
        python3 \
        python3-apt \
        sudo \
        systemd \
        systemd-sysv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# systemd's own idea of a clean shutdown.
STOPSIGNAL SIGRTMIN+3

CMD ["/lib/systemd/systemd"]
