# The RedHat-family half of the role suite. See Dockerfile.debian for why the
# suite needs a real PID 1 systemd at all.
#
# python3 and sudo are Ansible's requirements, not the role's. Everything the
# role itself needs - libcap included - is deliberately absent, so a missing
# dependency fails the suite instead of being masked by the image.
FROM rockylinux/rockylinux:9

RUN dnf -y install --setopt=install_weak_deps=False \
        python3 \
        sudo \
        systemd \
    && dnf clean all

STOPSIGNAL SIGRTMIN+3

CMD ["/usr/sbin/init"]
